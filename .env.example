# DroidOS Environment Configuration
# Copy to .env and adjust values

# Server
PORT=7070
HOST=127.0.0.1
# Set to 0.0.0.0 to enable LAN access after first-run setup
LAN_HOST=0.0.0.0

# Data directory (default: $HOME/.droidos)
# DATA_DIR=/data/data/com.termux/files/home/.droidos

# Security
# JWT_SECRET is auto-generated on first run; do not set manually
# JWT_SECRET=

# Session duration in seconds (default: 24h)
SESSION_TTL=86400

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Docker (optional)
DOCKER_ENABLED=false
# DOCKER_HOST=unix:///var/run/docker.sock

# Feature flags
ENABLE_TERMINAL=true
ENABLE_FILE_MANAGER=true
ENABLE_MONITORING=true

NODE_ENV=production
